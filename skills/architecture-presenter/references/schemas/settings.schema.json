{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Presenter settings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "theme": {"type": "string", "minLength": 1},
    "stageTheme": {"type": ["string", "null"], "minLength": 1},
    "exploreLayout": {"type": "string", "minLength": 1},
    "stageLayout": {"type": "string", "minLength": 1},
    "appearance": {"enum": ["system", "light", "dark"]},
    "userLibrary": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
  }
}
