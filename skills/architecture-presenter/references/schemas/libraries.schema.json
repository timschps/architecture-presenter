{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Device-local user library mappings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "default", "profiles"],
  "properties": {
    "schemaVersion": {"const": 1},
    "default": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "profiles": {
      "type": "object",
      "propertyNames": {"pattern": "^(?!local$)[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}
